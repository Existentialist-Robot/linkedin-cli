# linkedin-cli secrets — copy this file to `.env` and fill in your values.
# `.env` is gitignored; this `.env.example` is the tracked template (no real secrets).
# The CLI auto-loads `.env` from the current directory (or any parent) on startup.
# A variable already set in your shell always takes precedence over `.env`.

# --- Required for `linkedin-cli login` ---
LINKEDIN_USERNAME=you@example.com
LINKEDIN_PASSWORD=your-password-here

# --- Optional ---
# Default session name (otherwise 'default', or pass --session <name>)
# LINKEDIN_CLI_SESSION=work

# Log level: DEBUG / INFO / WARNING / ERROR
# LINKEDIN_CLI_LOG=INFO
